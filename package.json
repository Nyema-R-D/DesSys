{
  "name": "nyema-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Système de design NYEMA — tokens, composants React, configuration et automatisation partagées.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @nyema-r-d/reference run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "pnpm --filter @nyema-r-d/reference run dev",
    "storybook": "pnpm --filter @nyema-r-d/react run storybook",
    "build:storybook": "pnpm --filter @nyema-r-d/react run build:storybook",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "publint": "pnpm -r --filter \"./packages/**\" exec publint",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nyema-r-d/config": "workspace:*",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
