{
  "name": "@nyema-r-d/react",
  "version": "0.3.0",
  "description": "Composants React du système de design NYEMA.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nyema-R-D/DesSys.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "@nyema-r-d/tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": ">=1.0.0"
  },
  "devDependencies": {
    "@nyema-r-d/config": "workspace:*",
    "@nyema-r-d/css": "workspace:*",
    "@nyema-r-d/tokens": "workspace:*",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    }
  }
}
