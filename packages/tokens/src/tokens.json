{
  "$description": "Source unique des tokens NYEMA. Toute modification passe ici ; le build génère CSS, JS, TS et JSON.",
  "color": {
    "ink": {
      "950": "#0E0F0E",
      "900": "#161816",
      "800": "#202321",
      "700": "#2E322F",
      "650": "#3C403D",
      "600": "#5A5F5B",
      "500": "#6B706C",
      "400": "#7C827D",
      "300": "#A2A7A3"
    },
    "paper": {
      "50": "#F8F7F3",
      "100": "#F2F0EA",
      "200": "#E4E1D8"
    },
    "laterite": {
      "400": "#EE7A4B",
      "500": "#E2602E",
      "600": "#BC481B"
    },
    "status": {
      "research": "#7FA6E0",
      "prototype": "#D9B04E",
      "pilot": "#E2602E",
      "available": "#5FC08A"
    },
    "error": "#F0624D"
  },
  "themes": {
    "anthracite": {
      "surface-page": "{color.ink.950}",
      "surface-raised": "{color.ink.900}",
      "surface-sunken": "{color.ink.900}",
      "surface-disabled": "{color.ink.800}",
      "surface-inverse": "{color.paper.100}",
      "text-primary": "{color.paper.100}",
      "text-secondary": "{color.ink.300}",
      "text-tertiary": "{color.ink.400}",
      "text-inverse": "{color.ink.950}",
      "text-on-accent": "{color.ink.950}",
      "line-hairline": "rgba(242,240,234,.12)",
      "line-subtle": "rgba(242,240,234,.16)",
      "line-strong": "rgba(242,240,234,.28)",
      "line-contrast": "{color.paper.100}",
      "accent": "{color.laterite.500}",
      "accent-hover": "{color.laterite.400}",
      "accent-text": "{color.laterite.500}",
      "danger": "{color.error}",
      "status-research": "{color.status.research}",
      "status-prototype": "{color.status.prototype}",
      "status-pilot": "{color.status.pilot}",
      "status-available": "{color.status.available}"
    },
    "paper": {
      "surface-page": "{color.paper.100}",
      "surface-raised": "{color.paper.50}",
      "surface-sunken": "#FFFFFF",
      "surface-disabled": "{color.paper.200}",
      "surface-inverse": "{color.ink.950}",
      "text-primary": "{color.ink.950}",
      "text-secondary": "{color.ink.650}",
      "text-tertiary": "{color.ink.600}",
      "text-inverse": "{color.paper.100}",
      "text-on-accent": "{color.ink.950}",
      "line-hairline": "{color.paper.200}",
      "line-subtle": "rgba(14,15,14,.16)",
      "line-strong": "rgba(14,15,14,.28)",
      "line-contrast": "{color.ink.950}",
      "accent": "{color.laterite.500}",
      "accent-hover": "{color.laterite.400}",
      "accent-text": "{color.laterite.600}",
      "danger": "#C8321D",
      "status-research": "#3D6FB8",
      "status-prototype": "#A07A16",
      "status-pilot": "{color.laterite.600}",
      "status-available": "#2E9C61"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "144px"
  },
  "radius": {
    "0": "0",
    "1": "2px"
  },
  "border": {
    "hairline": "1px"
  },
  "layout": {
    "container": "1360px",
    "gutter": "clamp(20px,4vw,56px)",
    "breakpoint-stack": "900px"
  },
  "control": {
    "nav": "40px",
    "field": "48px",
    "cta": "52px",
    "cta-lg": "56px"
  },
  "motion": {
    "ease-out": "cubic-bezier(.2,.7,.2,1)",
    "dur-fast": "140ms",
    "dur-base": "240ms",
    "dur-slow": "600ms"
  },
  "focus": {
    "ring-width": "2px",
    "ring-offset": "2px",
    "ring-color": "{color.laterite.500}"
  },
  "font": {
    "sans": "'Archivo',system-ui,sans-serif",
    "mono": "'JetBrains Mono',ui-monospace,monospace"
  },
  "stretch": {
    "display": "118%",
    "headline": "112%",
    "heading": "110%",
    "title": "108%",
    "body": "100%"
  },
  "type": {
    "display": "600 clamp(48px,8.2vw,124px)/0.92 var(--font-sans)",
    "h1": "600 clamp(40px,5.6vw,84px)/0.95 var(--font-sans)",
    "h2": "600 clamp(32px,4vw,56px)/1 var(--font-sans)",
    "h3": "600 26px/1.1 var(--font-sans)",
    "body-lg": "400 20px/1.5 var(--font-sans)",
    "body": "400 17px/1.55 var(--font-sans)",
    "small": "400 14px/1.5 var(--font-sans)",
    "label": "500 12px/1.3 var(--font-mono)"
  },
  "tracking": {
    "label": ".08em",
    "logotype": ".04em",
    "display": "-.03em",
    "headline": "-.025em",
    "heading": "-.02em"
  }
}
